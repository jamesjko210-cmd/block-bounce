# ---- Unity generated / regenerable folders (NEVER commit these) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only exist when the asset itself exists
!/[Aa]ssets/**/*.meta

# Gradle / Android / iOS export leftovers
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
ExportedObj/
.consulo/
*.svd
*.userprefs
/*.csproj
/*.unityproj
/*.sln
/*.slnx
/*.suo
/*.tmp
/*.user
/*.userosscache
/*.sln.docstates
.vs/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics / Visual Studio cache
crashlytics-build.properties
/[Aa]ssets/[Aa]ddressableAssetsData/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Blender working files (keep source .blend, ignore backups) ----
*.blend1
*.blend2
*.blend@

# ---- OS / editor noise ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
